      {
        "service_date": "2026-03-28",
        "weekday": "Saturday",
        "day_start_utc": "2026-03-27T23:00:00Z",
        "note": "CET +01:00; 26:30:00 -> 2026-03-29T03:30 local because that civil night is only 23 hours long"
      },
      {
        "service_date": "2026-03-29",
        "weekday": "Sunday",
        "day_start_utc": "2026-03-28T22:00:00Z",
        "note": "spring forward at 02:00 CET; anchor is 23:00 local on the 28th (UTC 22:00)"
      },
      {
        "service_date": "2026-03-30",
        "weekday": "Monday",
        "day_start_utc": "2026-03-29T22:00:00Z",
        "note": "CEST +02:00 from the anchor onward"
      },
      {
        "service_date": "2026-10-24",
        "weekday": "Saturday",
        "day_start_utc": "2026-10-23T22:00:00Z",
        "note": "CEST +02:00; 26:30:00 is 02:30 on 2026-10-25 which occurs twice (ambiguous); the contract does not care because seconds are counted from the anchor"
      },
      {
        "service_date": "2026-10-25",
        "weekday": "Sunday",
        "day_start_utc": "2026-10-24T23:00:00Z",
        "note": "fall back at 03:00 CEST -> 02:00 CET; anchor is 01:00 local CEST, 12 actual hours before 13:00 local"
      },
      {
        "service_date": "2026-10-26",
        "weekday": "Monday",
        "day_start_utc": "2026-10-25T23:00:00Z",
        "note": "CET +01:00"
      }
    ],
