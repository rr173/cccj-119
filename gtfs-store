#!/usr/bin/env python3
"""Executable wrapper for the gtfs_store CLI.

Run from the repository root; imports are kept out of the script's own
directory so a planted module in the working directory cannot be loaded
by accident (the package is resolved from its fixed install location).
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from gtfs_store.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
